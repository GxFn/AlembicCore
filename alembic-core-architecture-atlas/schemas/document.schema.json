{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "topicId",
    "title",
    "question",
    "truthKind",
    "reviewDepth",
    "sourcePaths",
    "testPaths",
    "configPaths",
    "consumerRefs",
    "risks",
    "diagrams",
    "sourceFingerprint",
    "contextFingerprint",
    "baselineCommit",
    "reviewOrigin",
    "reviewedAt",
    "dependencySelection",
    "moduleDetails",
    "failureModes"
  ],
  "properties": {
    "topicId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "question": {
      "type": "string"
    },
    "truthKind": {
      "enum": [
        "current-code",
        "in-progress-worktree",
        "historical",
        "target-design",
        "stale"
      ]
    },
    "reviewDepth": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "diagrams": {
      "type": "array",
      "minItems": 1
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "testPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "configPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencySelection": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "moduleDetails": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "failureModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
