  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "clean:dist": "node scripts/clean-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:public-api": "node scripts/smoke-public-api.mjs",
    "check:output-budgets": "node scripts/check-output-budgets.mjs",
    "check:space-edges": "node scripts/check-space-edges.mjs",
    "lint:doctrine": "node scripts/lint-doctrine.mjs",
    "lint:naming": "node scripts/lint-naming.mjs",
    "lint:public-api-boundary": "node scripts/check-public-api-boundary.mjs",
    "lint:layer-contract": "node scripts/lint-layer-contract.mjs",
    "lint:consumer-core-imports": "node scripts/lint-consumer-core-imports-all.mjs",
    "lint:scope-resolution": "node scripts/lint-scope-resolution.mjs",
    "report:public-api-closeout": "node scripts/report-public-api-closeout.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "lint": "biome check src/ test/ scripts/ *.ts",
    "lint:fix": "biome check --fix src/ test/ scripts/ *.ts",
    "format": "biome format --write src/ test/ scripts/ *.ts",
    "check": "npm run build:check && npm run lint:public-api-boundary && npm run lint:layer-contract && npm run lint:consumer-core-imports && npm run lint:scope-resolution && npm run smoke:public-api && npm run check:output-budgets && npm run check:space-edges && npm run lint:doctrine && npm run lint:naming && npm run test && npm run lint"
  },
