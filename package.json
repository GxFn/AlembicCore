{
  "name": "@alembic/core",
  "version": "0.1.0",
  "description": "Shared headless core contracts for Alembic runtimes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js"
    },
    "./domain/dimension": {
      "types": "./dist/domain/dimension/index.d.ts",
      "import": "./dist/domain/dimension/index.js"
    },
    "./domain/dimension/*": {
      "types": "./dist/domain/dimension/*.d.ts",
      "import": "./dist/domain/dimension/*.js"
    },
    "./domain/evolution/*": {
      "types": "./dist/domain/evolution/*.d.ts",
      "import": "./dist/domain/evolution/*.js"
    },
    "./domain/knowledge": {
      "types": "./dist/domain/knowledge/index.d.ts",
      "import": "./dist/domain/knowledge/index.js"
    },
    "./domain/knowledge/values": {
      "types": "./dist/domain/knowledge/values/index.d.ts",
      "import": "./dist/domain/knowledge/values/index.js"
    },
    "./domain/knowledge/values/*": {
      "types": "./dist/domain/knowledge/values/*.d.ts",
      "import": "./dist/domain/knowledge/values/*.js"
    },
    "./domain/knowledge/*": {
      "types": "./dist/domain/knowledge/*.d.ts",
      "import": "./dist/domain/knowledge/*.js"
    },
    "./domain/snippet/*": {
      "types": "./dist/domain/snippet/*.d.ts",
      "import": "./dist/domain/snippet/*.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js"
    },
    "./infrastructure/config": {
      "types": "./dist/infrastructure/config/index.d.ts",
      "import": "./dist/infrastructure/config/index.js"
    },
    "./infrastructure/config/*": {
      "types": "./dist/infrastructure/config/*.d.ts",
      "import": "./dist/infrastructure/config/*.js"
    },
    "./infrastructure/io": {
      "types": "./dist/infrastructure/io/index.d.ts",
      "import": "./dist/infrastructure/io/index.js"
    },
    "./infrastructure/io/*": {
      "types": "./dist/infrastructure/io/*.d.ts",
      "import": "./dist/infrastructure/io/*.js"
    },
    "./infrastructure/*": {
      "types": "./dist/infrastructure/*.d.ts",
      "import": "./dist/infrastructure/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/ test/ *.ts",
    "lint:fix": "biome check --fix src/ test/ *.ts",
    "format": "biome format --write src/ test/ *.ts",
    "check": "npm run build:check && npm run test && npm run lint"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "p-limit": "^7.3.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/node": "^22.19.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
